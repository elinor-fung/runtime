<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <CLRTestKind>BuildAndRun</CLRTestKind>
    <CLRTestPriority>0</CLRTestPriority>
    <!-- The test loads assemblies into non-collectible ALCs, which is incompatible
         with the unloadability test harness. -->
    <UnloadabilityIncompatible>true</UnloadabilityIncompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ALCMismatch.cs" />
  </ItemGroup>
  <!-- Build the helper DLLs and make them available next to the test exe. -->
  <ItemGroup>
    <ProjectReference Include="PluginType.csproj" />
    <ProjectReference Include="PluginWorker.csproj" />
    <ProjectReference Include="PluginCaller.csproj" />
  </ItemGroup>
</Project>
